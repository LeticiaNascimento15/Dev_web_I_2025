css

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f2f4f7;
}

/* TOPO */

.topo{
    background:#0c1f4d;
    color:#fff;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:12px 20px;
    border-bottom:4px solid #ffc107;
}

.empresa{
    font-size:18px;
    font-weight:bold;
}

.info{
    font-size:15px;
}

/* MENU PRINCIPAL */

.menu-principal{
    background:#10285f;
}

.menu-principal ul{
    display:flex;
    flex-wrap:wrap;
    list-style:none;
}

.menu-principal a{
    display:block;
    color:white;
    text-decoration:none;
    padding:12px 18px;
    border-right:1px solid rgba(255,255,255,.1);
    transition:.3s;
}

.menu-principal a:hover{
    background:#18367d;
}

/* SUBMENU */

.menu-acoes{
    background:#ffc107;
    border-bottom:3px solid #0c1f4d;
}

.menu-acoes ul{
    display:flex;
    flex-wrap:wrap;
    list-style:none;
}

.menu-acoes a{
    display:block;
    text-decoration:none;
    color:#0c1f4d;
    font-weight:bold;
    padding:10px 16px;
    transition:.3s;
}

.menu-acoes a:hover{
    background:#ffcf33;
}

/* CONTEÚDO */

.conteudo{
    padding:20px;
}

.box{
    background:white;
    border-radius:8px;
    padding:20px;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
}

.box h2{
    margin-bottom:10px;
    color:#0c1f4d;
}