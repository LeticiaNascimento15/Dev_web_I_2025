<?php
require_once 'conexaoP.php';

$pdo = getPDO();
$cliente = null;
$erro = '';
$codigo = trim($_GET['A1_COD'] ?? '');

if ($codigo !== '') {
    try {
        $sql = "SELECT
                    A1_COD,
                    A1_NOME,
                    A1_END,
                    A1_EST,
                    A1_EMAIL,
                    A1_TEL,
                    A1_DDD,
                    A1_CGC,
                    A1_TIPO
                FROM clientes
                WHERE A1_COD = :codigo
                LIMIT 1";

        $stmt = $pdo->prepare($sql);
        $stmt->execute([':codigo' => $codigo]);

        $cliente = $stmt->fetch(PDO::FETCH_ASSOC);

        if (!$cliente) {
            $erro = 'Nenhum cliente encontrado com esse código.';
        }
    } catch (PDOException $e) {
        error_log($e->getMessage());
        $erro = 'Erro ao consultar o cliente. Verifique a consulta e os campos da tabela.';
    }
}

function h($valor) {
    return htmlspecialchars((string)($valor ?? ''), ENT_QUOTES, 'UTF-8');
}
