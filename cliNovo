    <script>
        function selecionarCliente(cliente) {
            const janelaPedidos = window.opener;

            if (!janelaPedidos || janelaPedidos.closed) {
                alert('A janela de pedidos não está aberta.');
                return;
            }

            const telaPrincipal = janelaPedidos.opener;

            if (!telaPrincipal || telaPrincipal.closed) {
                alert('A tela principal não está aberta.');
                return;
            }

            telaPrincipal.postMessage(
                {
                    tipo: 'cliente-selecionado',
                    cliente: cliente
                },
                window.location.origin
            );

            window.close();
            janelaPedidos.close();
        }
    </script>
</head>

<body>

    <h2>Selecionar Cliente</h2>

    <form class="busca" method="get" action="clientes.php">
        <label for="A1_COD">Código do cliente:</label>

        <input
            type="text"
            id="A1_COD"
            name="A1_COD"
            maxlength="6"
            value="<?= h($codigo) ?>"
            required
        >

        <button type="submit">Pesquisar</button>
    </form>

    <?php if ($erro !== ''): ?>
        <p class="mensagem"><?= h($erro) ?></p>
    <?php endif; ?>

    <?php if ($cliente): ?>
        <table class="tabela">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th>Endereço</th>
                    <th>UF</th>
                    <th>Telefone</th>
                    <th>Ação</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td><?= h($cliente['A1_COD']) ?></td>
                    <td><?= h($cliente['A1_NOME']) ?></td>
                    <td><?= h($cliente['A1_END']) ?></td>
                    <td><?= h($cliente['A1_EST']) ?></td>
                    <td>
                        <?= h($cliente['A1_DDD']) ?>
                        <?= h($cliente['A1_TEL']) ?>
